@model IEnumerable<Entities.Models.Event>

@{
    ViewData["Title"] = "Etkinlik Yönetimi";
}

<h2>Etkinlik Yönetimi</h2>

@if (TempData["ErrorMessage"] is not null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}


<a asp-action="Create" class="btn btn-primary mb-3">Yeni Etkinlik Oluştur</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Görsel</th>
            <th>Başlık</th>
            <th>Başlangıç</th>
            <th>Bitiş</th>
            <th>Oluşturan Kullanıcı</th>
            <th>Oluşturulma Tarihi</th>
            <th>Aktiflik</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var eventEntity in Model)
        {
            <tr>
                <td><img src="@eventEntity.ImagePath" alt="@eventEntity.Title" style="width:100px; height:auto;" /></td>
                <td>
                    <a asp-action="Edit" asp-route-id="@eventEntity.EventId" class="text-decoration-none">
                        @eventEntity.Title
                    </a>
                </td>
                <td>@eventEntity.StartDateTime.ToString("dd.MM.yyyy HH:mm")</td>
                <td>@eventEntity.EndDateTime.ToString("dd.MM.yyyy HH:mm")</td>
                <td>@eventEntity.CreatedByUser.FirstName @eventEntity.CreatedByUser.LastName</td>
                <td>@eventEntity.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                <td>@(eventEntity.IsActive ? "Aktif" : "Pasif")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@eventEntity.EventId" class="btn btn-warning btn-sm">Düzenle</a>
                    <form asp-action="Delete" asp-route-id="@eventEntity.EventId" method="post" class="d-inline"
                          onsubmit="return confirm('Bu etkinliği silmek istediğinize emin misiniz?');">

                        <button type="submit" class="btn btn-danger btn-sm">Sil</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>