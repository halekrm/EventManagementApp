@using System.Security.Claims
@model IEnumerable<Entities.Models.Event>

@{
    ViewData["Title"] = "Etkinlik Yönetimi";

    var currentUserIdValue = User.FindFirstValue(ClaimTypes.NameIdentifier);

    var currentUserId = string.IsNullOrEmpty(currentUserIdValue)
        ? (int?)null
        : int.Parse(currentUserIdValue);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Etkinlik Yönetimi</h2>
        @if (User.IsInRole("Admin"))
        {
            <p class="text-muted mb-0">
                Tüm etkinlikleri görüntüleyebilir, düzenleyebilir veya silebilirsiniz.
            </p>
        }
        else
        {
            <p class="text-muted mb-0">
                Kayıtlı etkinlikleri görüntüleyebilir, kendi etkinliklerinizi düzenleyebilir veya silebilirsiniz.
            </p>
        }
    </div>

    <a asp-action="Create" class="btn btn-primary">Yeni Etkinlik Oluştur</a>
</div>

@if (TempData["ErrorMessage"] is not null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="card shadow-sm border-0">
    <div class="card-body">
        <div class="table-responsive">


            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Görsel</th>
                        <th>Başlık</th>
                        <th>Başlangıç</th>
                        <th>Bitiş</th>
                        <th>Oluşturan Kullanıcı</th>
                        <th>Oluşturulma Tarihi</th>
                        <th>Durum</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var eventEntity in Model)
                    {
                        bool canManage = User.IsInRole("Admin") ||
                        (currentUserId.HasValue && eventEntity.CreatedByUserId == currentUserId.Value);

                        <tr>
                            <td><img src="@eventEntity.ImagePath" alt="@eventEntity.Title" class="rounded"
                                         style="width:90px; height:60px; object-fit:cover;" /></td>
                                <td>
                                    @if (canManage)
                                    {
                                        <a asp-action="Edit" asp-route-id="@eventEntity.EventId"
                                           class="text-decoration-none fw-semibold event-title-link">
                                            @eventEntity.Title
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="fw-semibold">@eventEntity.Title</span>
                                    }

                                </td>

                                <td>@eventEntity.StartDateTime.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>@eventEntity.EndDateTime.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>@eventEntity.CreatedByUser.FirstName @eventEntity.CreatedByUser.LastName</td>
                                <td>@eventEntity.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>
                                    @if (eventEntity.IsActive)
                                    {
                                        <span class="badge badge-active">Aktif</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-passive">Pasif</span>
                                    }
                                </td>
                                <td class="text-nowrap">
                                    @if (canManage)
                                    {
                                        <a asp-action="Edit" asp-route-id="@eventEntity.EventId"
                                           class="btn btn-edit btn-sm me-1">Düzenle</a>

                                        <button type="button" class="btn btn-delete btn-sm" data-bs-toggle="modal"
                                                data-bs-target="#deleteModal-@eventEntity.EventId">Sil
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">İşlem Yapılamaz</span>
                                    }

                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

@foreach (var eventEntity in Model)
{
    bool canManage = User.IsInRole("Admin") || (currentUserId.HasValue && eventEntity.CreatedByUserId == currentUserId.Value);

    if (canManage)
    {
        <div class="modal fade" id="deleteModal-@eventEntity.EventId" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content delete-modal">
                    <div class="modal-header border-0">
                        <h5 class="modal-title">Etkinliği Sil</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                    </div>

                    <div class="modal-body">
                        <p class="fw-semibold mb-2">@eventEntity.Title</p>
                        <p class="text-muted mb-0">Bu etkinliği silmek istediğinize emin misiniz? Bu işlem geri alınamaz.</p>
                    </div>

                    <div class="modal-footer border-0">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Vazgeç</button>
                        <form asp-action="Delete" asp-route-id="@eventEntity.EventId" method="post" class="m-0">
                            <button type="submit" class="btn delete-modal-button">Sil</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
}
