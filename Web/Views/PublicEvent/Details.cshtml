@model Web.Models.PublicEventDetailViewModel

@{
    ViewData["Title"] = Model.Event.Title;
}

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <img src="@Model.Event.ImagePath" class="card-img-top" alt="@Model.Event.Title" style="max-height:420px; object-fit:cover;" />
            <div class="card-body">
                <h1 class="card-title mb-3">@Model.Event.Title</h1>
                <p class="mb-1"><strong>Başlangıç:</strong> @Model.Event.StartDateTime.ToString("dd.MM.yyyy HH:mm")</p>
                <p class="mb-4"><strong>Bitiş:</strong> @Model.Event.EndDateTime.ToString("dd.MM.yyyy HH:mm")</p>
                <div class="event-description">
                    @Html.Raw(Model.Event.LongDescription)
                </div>
                <a asp-controller="PublicEvent" asp-action="Index" class="btn btn-outline-secondary mt-4">Etkinliklere Dön</a>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <h4 class="mb-3">Son Etkinlikler</h4>
        @foreach (var eventEntity in Model.LatestEvents)
        {
            <div class="card mb-3 shadow-sm">
                <div class="card-body">
                    <h6 class="card-title">@eventEntity.Title</h6>
                    <p class="small mb-2">@eventEntity.StartDateTime.ToString("dd.MM.yyyy HH:mm")</p>
                    <a asp-controller="PublicEvent" asp-action="Details" asp-route-id="@eventEntity.EventId" class="btn btn-sm btn-outline-primary">Detayları Gör</a>
                </div>
            </div>
        }
    </div>
</div>