@model IEnumerable<Entities.Models.Event>

@{
    ViewData["Title"] = "Etkinlikler";
}

<div class="p-4 p-md-5 mb-4 rounded-3 hero-card">
    <div class="row align-items-center">
        <div class="col-md-7">
            <h1 class="display-5 fw-bold">Etkinlik Yönetim Uygulaması</h1>
            <p class="fs-5 mt-3">
                Yaklaşan etkinlikleri keşfedebilir, etkinlik detaylarını inceleyebilir ve takvim görünümü üzerinden
                planlanan etkinlikleri takip edebilirsiniz.
            </p>
            <div class="mt-4">

                <a asp-controller="PublicEvent" asp-action="Calendar" class="btn btn-primary me-2 hero-button">Takvimi Görüntüle</a>

                @if (User.Identity?.IsAuthenticated != true)
                {
                    <a asp-controller="Account" asp-action="Register" class="btn btn-outline-secondary hero-button">Kayıt Ol</a>
                }
            </div>
        </div>

        <div class="col-md-5 text-center mt-4 mt-md-0">
            <img src="/images/event-management.png" alt="Etkinlik Yönetim Uygulaması" class="img-fluid hero-image"
                 style="max-height:300px; object-fit:cover;" />
        </div>
    </div>
</div>


<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Yaklaşan Etkinlikler</h2>
</div>

@if (Model != null && Model.Any())
{
    <div class="row g-4">
        @foreach (var eventEntity in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                    <img src="@eventEntity.ImagePath" class="card-img-top" alt="@eventEntity.Title" style="height:220px; object-fit:cover;" />
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@eventEntity.Title</h5>
                        <p class="card-text mb-1"><strong>Başlangıç:</strong> @eventEntity.StartDateTime.ToString("dd.MM.yyyy HH:mm")</p>
                        <p class="card-text mb-3"><strong>Bitiş:</strong> @eventEntity.EndDateTime.ToString("dd.MM.yyyy HH:mm")</p>
                        <p class="card-text">@eventEntity.ShortDescription</p>
                        <div class="mt-auto">
                            <a asp-controller="PublicEvent" asp-action="Details" asp-route-id="@eventEntity.EventId" class="btn btn-primary w-100 stretched-link">Detayları Gör</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-info">Yaklaşan aktif etkinlik bulunmamaktadır.</div>
}