@model IEnumerable<Entities.Models.Event>

@{
    ViewData["Title"] = "Etkinlikler";
}

<div class="mb-4">
    <h1>Etkinlik Yönetim Uygulaması</h1>

    <img src="/images/event-management.png" alt="Etkinlik Yönetim Uygulaması" class="img-fluid mb-3"
         style="max-height:300px; object-fit:cover;" />

    <p>
        Yaklaşan etkinlikleri keşfedebilir, etkinlik detaylarını
        inceleyebilir ve takvim görünümü üzerinden planlanan
        etkinlikleri takip edebilirsiniz.
    </p>

    <a asp-controller="PublicEvent" asp-action="Calendar" class="btn btn-outline-secondary">
        Takvim Görünümü
    </a>
</div>

<hr />

<h2>Yaklaşan Etkinlikler</h2>

@if (Model != null && Model.Any())
{
    <div class="row">
        @foreach (var eventEntity in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100">
                    <img src="@eventEntity.ImagePath" class="card-img-top" alt="@eventEntity.Title"
                         style="height:220px; object-fit:cover;" />
                    <div class="card-body">
                        <h5 class="card-title">@eventEntity.Title</h5>
                        <p class="card-text"><strong>Başlangıç:</strong> @eventEntity.StartDateTime.ToString("dd.MM.yyyy HH:mm")
                        </p>
                        <p class="card-text"><strong>Bitiş:</strong> @eventEntity.EndDateTime.ToString("dd.MM.yyyy HH:mm")</p>
                        <p class="card-text">@eventEntity.ShortDescription</p>
                        <a asp-controller="PublicEvent" asp-action="Details" asp-route-id="@eventEntity.EventId"
                           class="btn btn-primary">Detayları Gör</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <p>Yaklaşan aktif etkinlik bulunmamaktadır.</p>
}